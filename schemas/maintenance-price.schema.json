{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cost-workbench/schemas/maintenance-price/1.0.0",
  "title": "MaintenancePriceImport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/maintenancePriceRecord" }
    }
  },
  "$defs": {
    "maintenancePriceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client",
        "service",
        "productModel",
        "serviceLevel",
        "site",
        "coverageMonths",
        "quantity",
        "costAmount",
        "quotedAmount",
        "currency",
        "quoteDate",
        "outcome",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "client": { "type": "string", "minLength": 1, "maxLength": 200 },
        "service": { "type": "string", "minLength": 1, "maxLength": 300 },
        "productModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "serviceLevel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "site": { "type": "string", "minLength": 1, "maxLength": 200 },
        "coverageMonths": { "type": "integer", "minimum": 1, "maximum": 240 },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "costAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "quotedAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "currency": { "const": "SGD" },
        "quoteDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "outcome": { "enum": ["Quoted", "Won", "Lost", "Reference"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
