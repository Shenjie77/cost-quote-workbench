{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cost-workbench/schemas/workspace-state/1.0.0",
  "title": "LocalWorkbenchWorkspaceV1",
  "description": "Atomic local SQLite workspace shared by the browser and Agent CLI. Cost structures reuse the canonical cost-export/2.0.0 definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "selectedStep",
    "processSteps",
    "activeVersion",
    "costRows",
    "rateSettings",
    "resourceTypes",
    "subcontractItems",
    "supplementalCostItems",
    "maintenancePriceRecords",
    "travelSettings",
    "travelRows",
    "travelUplift",
    "manualCosts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": {
      "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/project"
    },
    "selectedStep": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "currentWorkflowStepCode": { "$ref": "#/$defs/text" },
    "processSteps": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/workflowStep" }
    },
    "projectStatus": { "$ref": "#/$defs/identifier" },
    "projectStatusDefinitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/projectStatusDefinition" }
    },
    "reviewGates": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/reviewGate" }
    },
    "activeVersion": { "type": "string", "pattern": "^V[1-9][0-9]*$" },
    "costVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/costVersion" }
    },
    "costRows": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/draftCostRow" }
    },
    "rateSettings": {
      "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/rateSettings"
    },
    "resourceTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/resourceType"
      }
    },
    "subcontractItems": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/subcontractItem" }
    },
    "supplementalCostItems": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/supplementalCostItem" }
    },
    "maintenancePriceRecords": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/maintenancePriceRecord" }
    },
    "travelSettings": {
      "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/travelSettings"
    },
    "travelRows": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/travelRow" }
    },
    "travelUplift": { "type": "number", "minimum": -100, "maximum": 1000 },
    "manualCosts": {
      "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/manualCosts"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetGrossMargin", "discount", "gstPercent"],
      "properties": {
        "targetGrossMargin": { "type": "number", "minimum": 0, "maximum": 95 },
        "discount": { "$ref": "#/$defs/money" },
        "gstPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "quoteTemplates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/quoteTemplate" }
    },
    "selectedQuoteTemplateId": { "$ref": "#/$defs/identifier" },
    "quoteAssumptions": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/quoteAssumption" }
    },
    "quoteHistory": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/quoteHistoryRecord" }
    }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 2000 },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "money": { "type": "number", "minimum": 0, "maximum": 1000000000000 },
    "costVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "state",
        "createdAt",
        "sourceVersion",
        "costRows",
        "rateSettings",
        "travelSettings",
        "travelRows",
        "travelUplift",
        "manualCosts"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^V[1-9][0-9]*$" },
        "state": { "enum": ["Draft", "Suspended", "Confirmed"] },
        "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "sourceVersion": {
          "anyOf": [
            { "type": "string", "pattern": "^V[1-9][0-9]*$" },
            { "type": "null" }
          ]
        },
        "costRows": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/draftCostRow" }
        },
        "rateSettings": {
          "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/rateSettings"
        },
        "travelSettings": {
          "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/travelSettings"
        },
        "travelRows": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/travelRow" }
        },
        "travelUplift": { "type": "number", "minimum": -100, "maximum": 1000 },
        "manualCosts": {
          "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/manualCosts"
        }
      }
    },
    "draftCostRow": {
      "description": "Autosaved working row. Required export fields may remain blank while the user is editing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "bu", "reTypeId", "mdPerSite", "years"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scope": { "type": "string", "maxLength": 500 },
        "bu": { "type": "string", "maxLength": 200 },
        "reTypeId": { "type": "string", "maxLength": 100 },
        "mdPerSite": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "years": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/yearAllocation"
                },
                {
                  "type": "object",
                  "properties": { "bucket": { "const": "Y1" } }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/yearAllocation"
                },
                {
                  "type": "object",
                  "properties": { "bucket": { "const": "Y2" } }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/yearAllocation"
                },
                {
                  "type": "object",
                  "properties": { "bucket": { "const": "Y3" } }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/yearAllocation"
                },
                {
                  "type": "object",
                  "properties": { "bucket": { "const": "Y4" } }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "https://local.cost-workbench/schemas/cost-export/2.0.0#/$defs/yearAllocation"
                },
                {
                  "type": "object",
                  "properties": { "bucket": { "const": "Y5" } }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "no",
        "name",
        "nameZh",
        "owner",
        "state",
        "tone",
        "date",
        "dateZh",
        "detail",
        "detailZh",
        "input",
        "inputZh",
        "required"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "no": { "$ref": "#/$defs/nonBlankText" },
        "name": { "$ref": "#/$defs/nonBlankText" },
        "nameZh": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/nonBlankText" },
        "state": {
          "enum": [
            "completed",
            "in_progress",
            "awaiting_review",
            "blocked",
            "not_started"
          ]
        },
        "tone": { "enum": ["green", "amber", "red", "blue", "gray", "navy"] },
        "date": { "$ref": "#/$defs/text" },
        "dateZh": { "$ref": "#/$defs/text" },
        "detail": { "$ref": "#/$defs/text" },
        "detailZh": { "$ref": "#/$defs/text" },
        "input": { "$ref": "#/$defs/text" },
        "inputZh": { "$ref": "#/$defs/text" },
        "required": { "type": "boolean" }
      }
    },
    "projectStatusDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "nameZh", "active"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonBlankText" },
        "nameZh": { "$ref": "#/$defs/text" },
        "active": { "type": "boolean" }
      }
    },
    "reviewFollowUp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "summary",
        "statusAfter",
        "nextFollowUpAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "summary": { "$ref": "#/$defs/nonBlankText" },
        "statusAfter": {
          "enum": [
            "not_started",
            "awaiting_material",
            "in_review",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "nextFollowUpAt": {
          "anyOf": [
            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            { "const": "" }
          ]
        }
      }
    },
    "reviewGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "gate",
        "gateZh",
        "owner",
        "dueDate",
        "status",
        "note",
        "noteZh",
        "workflowStepCode",
        "lastUpdatedAt",
        "followUps"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "gate": { "$ref": "#/$defs/nonBlankText" },
        "gateZh": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/nonBlankText" },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": {
          "enum": [
            "not_started",
            "awaiting_material",
            "in_review",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "note": { "$ref": "#/$defs/text" },
        "noteZh": { "$ref": "#/$defs/text" },
        "workflowStepCode": { "$ref": "#/$defs/text" },
        "lastUpdatedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "followUps": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/reviewFollowUp" }
        }
      }
    },
    "quoteTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nameZh",
        "clientPattern",
        "documentTitle",
        "documentTitleZh",
        "validityDays",
        "paymentTerms",
        "paymentTermsZh",
        "active"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonBlankText" },
        "nameZh": { "$ref": "#/$defs/text" },
        "clientPattern": { "$ref": "#/$defs/nonBlankText" },
        "documentTitle": { "$ref": "#/$defs/nonBlankText" },
        "documentTitleZh": { "$ref": "#/$defs/text" },
        "validityDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "paymentTerms": { "$ref": "#/$defs/nonBlankText" },
        "paymentTermsZh": { "$ref": "#/$defs/text" },
        "active": { "type": "boolean" }
      }
    },
    "quoteAssumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "textZh", "included"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "text": { "$ref": "#/$defs/nonBlankText" },
        "textZh": { "$ref": "#/$defs/text" },
        "included": { "type": "boolean" }
      }
    },
    "quoteHistoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "quoteNumber",
        "generatedAt",
        "costVersion",
        "templateId",
        "status",
        "costAmount",
        "quoteBeforeTax",
        "gstAmount",
        "quoteAfterTax",
        "grossMarginPercent",
        "note"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "quoteNumber": { "$ref": "#/$defs/nonBlankText" },
        "generatedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "costVersion": { "type": "string", "pattern": "^V[1-9][0-9]*$" },
        "templateId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["Draft", "Final"] },
        "costAmount": { "$ref": "#/$defs/money" },
        "quoteBeforeTax": { "$ref": "#/$defs/money" },
        "gstAmount": { "$ref": "#/$defs/money" },
        "quoteAfterTax": { "$ref": "#/$defs/money" },
        "grossMarginPercent": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100
        },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "subcontractItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "item",
        "bu",
        "supplier",
        "pricingBasis",
        "currency",
        "active"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/nonBlankText" },
        "item": { "$ref": "#/$defs/nonBlankText" },
        "bu": { "$ref": "#/$defs/nonBlankText" },
        "supplier": { "$ref": "#/$defs/nonBlankText" },
        "pricingBasis": { "$ref": "#/$defs/nonBlankText" },
        "currency": { "$ref": "#/$defs/nonBlankText" },
        "active": { "type": "boolean" }
      }
    },
    "supplementalCostItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "statementCode",
        "defaultAmount",
        "currency",
        "owner",
        "sourceNote",
        "active"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/nonBlankText" },
        "name": { "$ref": "#/$defs/nonBlankText" },
        "statementCode": { "$ref": "#/$defs/nonBlankText" },
        "defaultAmount": { "$ref": "#/$defs/money" },
        "currency": { "const": "SGD" },
        "owner": { "$ref": "#/$defs/text" },
        "sourceNote": { "$ref": "#/$defs/text" },
        "active": { "type": "boolean" }
      }
    },
    "maintenancePriceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client",
        "service",
        "productModel",
        "serviceLevel",
        "site",
        "coverageMonths",
        "quantity",
        "costAmount",
        "quotedAmount",
        "currency",
        "quoteDate",
        "outcome",
        "source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "client": { "$ref": "#/$defs/nonBlankText" },
        "service": { "$ref": "#/$defs/nonBlankText" },
        "productModel": { "$ref": "#/$defs/nonBlankText" },
        "serviceLevel": { "$ref": "#/$defs/nonBlankText" },
        "site": { "$ref": "#/$defs/nonBlankText" },
        "coverageMonths": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "quantity": { "type": "number", "minimum": 0, "maximum": 1000000000 },
        "costAmount": { "$ref": "#/$defs/money" },
        "quotedAmount": { "$ref": "#/$defs/money" },
        "currency": { "const": "SGD" },
        "quoteDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "outcome": { "enum": ["Quoted", "Won", "Lost", "Reference"] },
        "source": { "$ref": "#/$defs/nonBlankText" }
      }
    },
    "travelRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "bu",
        "destination",
        "expenseType",
        "unitBasis",
        "baseUnitRate",
        "currency",
        "rateBaseYear",
        "quantities",
        "treatment"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scope": { "$ref": "#/$defs/nonBlankText" },
        "bu": { "$ref": "#/$defs/nonBlankText" },
        "destination": { "$ref": "#/$defs/nonBlankText" },
        "expenseType": { "$ref": "#/$defs/nonBlankText" },
        "unitBasis": { "$ref": "#/$defs/nonBlankText" },
        "baseUnitRate": { "$ref": "#/$defs/money" },
        "currency": { "$ref": "#/$defs/nonBlankText" },
        "rateBaseYear": { "type": "integer", "minimum": 2000, "maximum": 2200 },
        "quantities": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "number", "minimum": 0, "maximum": 1000000000 }
        },
        "treatment": { "enum": ["included", "reimbursable", "excluded"] }
      }
    }
  }
}
